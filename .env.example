# AI Service API Keys
# Uncomment and add your API keys for AI features

# Gemini AI API Key for reading generation
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA AI API Key for wallpaper generation  
NVIDIA_API_KEY=your_nvidia_api_key_here

# OpenRouter API Key (fallback for AI reading)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override endpoint URLs
# GEMINI_ENDPOINT=https://your-gemini-endpoint
# NVIDIA_ENDPOINT=https://your-nvidia-endpoint
# OPENROUTER_ENDPOINT=https://your-openrouter-endpoint
