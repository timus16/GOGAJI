{
  "name": "nakshatra-canvas",
  "main": "./dist/cloudflare-worker/index.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "PUBLIC_SITE_URL": "https://nakshatra-canvas.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}